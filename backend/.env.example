DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campustrack
DB_PORT=3306
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
RESET_TOKEN_DEV_MODE=true

# Comma-separated list of the exact email addresses allowed to register as a lecturer.
# A student cannot self-register as a lecturer unless their email is listed here —
# leave this empty to block ALL lecturer self-registration until you add staff emails.
# Format: LECTURER_ALLOWED_EMAILS=firstlecturer@example.com,secondlecturer@example.com
LECTURER_ALLOWED_EMAILS=

# Initial system administrator. Do NOT expose these in source control.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@campustrack.local
ADMIN_PASSWORD=change_this_admin_password

APP_TIMEZONE=Africa/Kampala
